# Copy this file to ".env" (same folder) and fill in what you need, then run KARMA.
# KARMA auto-loads .env from the project folder and from the data dir (%USERPROFILE%/.karma).
# Only DEEPSEEK_API_KEY is commonly needed; everything else has sane defaults.
KARMA_ENV=development
KARMA_HOST=127.0.0.1
KARMA_SENSOR_HOST=0.0.0.0
KARMA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],karma-honeypot.com,www.karma-honeypot.com
KARMA_ENABLE_SENSORS=1
KARMA_MAX_EVENTS=100000
# Only LAN/loopback addresses use this explicitly labeled display location.
KARMA_LAB_LOCATION_ENABLED=1
KARMA_LAB_CITY=Bengaluru
KARMA_LAB_COUNTRY=India
KARMA_LAB_LAT=12.9716
KARMA_LAB_LNG=77.5946
# Locate public attacker IPs with ip-api.com (sends only the attacker IP). 0 = never look up.
KARMA_GEOIP_ENABLED=1
# Also block quarantined IPs in Windows Firewall / iptables. Run KARMA as Administrator. 0 = KARMA decoys only.
KARMA_FIREWALL_BLOCK=0
# Initial mode only; a saved dashboard choice takes precedence.
KARMA_ENGAGEMENT_MODE=contain
# Optional reachable web SENSOR origin for document links (never admin port 8000).
# Defaults to the SSH connection's local address and web sensor port 8080.
# KARMA_CALLBACK_BASE_URL=http://192.168.137.1:8080
# KARMA_DATA_DIR=C:/path/to/private/karma-data
# KARMA_ADMIN_TOKEN=<generate a random secret of at least 32 characters>
# DeepSeek API key — enables free-form AI Copilot chat. Without it, the offline
# analyst still answers from live telemetry. You can also set this from the desktop GUI.
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
